msgid "RustFS"
msgstr ""

msgid "Settings"
msgstr ""

msgid "Updated RustFS settings."
msgstr ""

msgid "RustFS is an S3 compatible object storage server. Select the data shared folder first, then enable the service and click Save and then Apply. Buckets, users and policies are managed in the RustFS console."
msgstr ""

msgid "Status"
msgstr ""

msgid "Service status"
msgstr ""

msgid "Running means the RustFS service is active on this machine."
msgstr ""

msgid "Bundled version"
msgstr ""

msgid "The RustFS version that is bundled in this package."
msgstr ""

msgid "Data directory"
msgstr ""

msgid "The resolved path of the selected data shared folder."
msgstr ""

msgid "Service"
msgstr ""

msgid "Enabled"
msgstr ""

msgid "Start the RustFS service automatically at boot. A data shared folder must be selected first. Click Save and then Apply to take effect."
msgstr ""

msgid "Data shared folder"
msgstr ""

msgid "The shared folder that holds the RustFS object data. It must be located on a mounted filesystem. RustFS cannot be started before it is selected."
msgstr ""

msgid "Network"
msgstr ""

msgid "S3 API port"
msgstr ""

msgid "The port the S3 compatible API listens on. The default is 9000."
msgstr ""

msgid "Console port"
msgstr ""

msgid "The port of the RustFS web console. The default is 9001. It must differ from the S3 API port."
msgstr ""

msgid "Enable console"
msgstr ""

msgid "Serve the RustFS web console. Disable it to expose only the S3 API."
msgstr ""

msgid "Credentials"
msgstr ""

msgid "Access key"
msgstr ""

msgid "Used as the user name by every S3 client. It is generated randomly at install time."
msgstr ""

msgid "Secret key"
msgstr ""

msgid "Used as the password by every S3 client. Keep it secret and rotate it with the Regenerate credentials button."
msgstr ""

