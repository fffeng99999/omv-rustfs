#!/usr/bin/env dash
#
# This file is part of OpenMediaVault.
#
# @license   https://www.gnu.org/licenses/gpl.html GPL Version 3
# @author    ${GITHUB_USER} <${GITHUB_USER}@users.noreply.github.com>
#
# Control helper for the openmediavault-rustfs plugin. It is called by the
# engined RPC service and by the Salt state.
#
# Usage: omv-rustfs-ctl <op>
#
#   <op>   is-active|start|stop|restart|version|datapath|logs|showconfig
#
# RustFS runs as a native systemd service (rustfs.service) with the bundled
# /usr/bin/rustfs binary and the environment file /etc/default/rustfs, which
# is rendered by the Salt state from the OMV configuration database. The
# plugin never modifies RustFS itself.

set -u

. /usr/share/openmediavault/scripts/helper-functions

SERVICE="rustfs"
BIN="/usr/bin/rustfs"
ENV_FILE="/etc/default/rustfs"
UNIT_FILE="/etc/systemd/system/rustfs.service"
VERSION_FILE="/usr/share/rustfs/VERSION"

OP="${1:-}"

case "$OP" in
	is-active|start|stop|restart|version|datapath|logs|showconfig)
	;;
	*)
		echo "Usage: $0 <is-active|start|stop|restart|version|datapath|logs|showconfig>" >&2
		exit 2
	;;
esac

# Read a scalar property of a configuration object from the config
# database. The value may be quoted (string) or not (boolean/number), so
# the quotes are stripped and the result trimmed.
conf_value() {
	omv-confdbadm read "$1" 2>/dev/null | tr -d '\n' \
		| sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p" \
		| tr -d '"' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# Absolute path of the configured data shared folder (empty when unset).
data_path() {
	_ref="$(conf_value conf.service.rustfs dataRef)"
	[ -n "$_ref" ] || return 0
	omv_get_sharedfolder_path "$_ref" 2>/dev/null || true
}

# The service may only run once a data directory has been rendered into the
# environment file.
data_configured() {
	[ -f "$ENV_FILE" ] || return 1
	grep -q '^RUSTFS_VOLUMES="[^"]' "$ENV_FILE" 2>/dev/null
}

case "$OP" in
	is-active)
		if systemctl is-active --quiet "${SERVICE}.service"; then
			echo "running"
		else
			echo "stopped"
		fi
		exit 0
		;;

	start)
		if [ ! -f "$UNIT_FILE" ]; then
			echo "RustFS is not deployed yet. Save the settings and click Apply first." >&2
			exit 1
		fi
		if ! data_configured; then
			echo "No data shared folder configured. Select one and click Apply first." >&2
			exit 1
		fi
		systemctl start "${SERVICE}.service"
		# Propagate the systemctl exit status to the caller.
		exit $?
		;;

	stop)
		systemctl stop "${SERVICE}.service" 2>/dev/null || true
		;;

	restart)
		if [ ! -f "$UNIT_FILE" ]; then
			echo "RustFS is not deployed yet. Save the settings and click Apply first." >&2
			exit 1
		fi
		if ! data_configured; then
			echo "No data shared folder configured. Select one and click Apply first." >&2
			exit 1
		fi
		systemctl restart "${SERVICE}.service"
		# Propagate the systemctl exit status to the caller.
		exit $?
		;;

	version)
		# The bundled version stamp is written at package build time; the
		# binary is never executed just to read its version.
		if [ -f "$VERSION_FILE" ]; then
			cat "$VERSION_FILE"
		elif [ -x "$BIN" ]; then
			"$BIN" --version 2>/dev/null || true
		fi
		;;

	datapath)
		data_path
		;;

	logs)
		echo "===== journalctl -u ${SERVICE} -n 200 ====="
		journalctl -u "${SERVICE}.service" -n 200 --no-pager 2>&1 || true
		;;

	showconfig)
		echo "===== $ENV_FILE (generated by openmediavault-rustfs) ====="
		if [ -f "$ENV_FILE" ]; then
			cat "$ENV_FILE"
		else
			echo "The environment file has not been generated yet."
			echo "Select the data shared folder, click Save and then Apply."
		fi
		;;
esac

exit 0
